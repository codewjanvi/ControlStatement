# ==============================================================================
# ControlStatement Configuration Template
# Copy this file to .env and configure your local settings.
# All values should be empty in this template. Never commit real values or paths.
# ==============================================================================

# Local model backend configuration (e.g. Ollama endpoint)
LOCAL_MODEL_ENDPOINT=
LOCAL_MODEL_NAME=

# Regional & currency settings (e.g. INR, USD)
DEFAULT_CURRENCY=
DEFAULT_LOCALE=

# Application storage paths
DATA_DIR=
REPORTS_DIR=

# Logging level (DEBUG, INFO, WARNING, ERROR)
# NOTE: Logs only contain metadata; transaction details and PII are never logged.
LOG_LEVEL=

# Local web UI server settings
WEB_HOST=
WEB_PORT=
